# Agenora Docker Compose env template — copy to `.env` and edit.
#
# Generate strong secrets:
#   POSTGRES_PASSWORD=$(openssl rand -hex 16)
#   JWT_SECRET=$(openssl rand -hex 32)
#   NEO4J_PASSWORD=$(openssl rand -base64 32)
#   LIGHTRAG_API_KEY=$(openssl rand -base64 32)

# ===== Required =====
POSTGRES_PASSWORD=
JWT_SECRET=
# Compose validates KG service interpolation even when the profile is inactive.
# Set these strong values now; they are used only after ``--profile kg`` starts.
NEO4J_PASSWORD=
LIGHTRAG_API_KEY=

# ===== Public-facing URL (must match how users reach nginx) =====
# Used for CORS. Multiple origins: comma-separated.
PUBLIC_URL=http://localhost

# ===== Chat knowledge-base entry =====
# hidden (default): new chats are general chats. A KB page can still explicitly
# start a KB-bound chat. selectable: show a KB picker before the first message.
NEXT_PUBLIC_CHAT_KB_SELECTION_MODE=hidden

# ===== Production nginx (compose profile: production) =====
# Must match the Let's Encrypt directory name under /etc/letsencrypt/live/<DOMAIN>/.
# DOMAIN=example.com
# PUBLIC_URL=https://example.com
DOMAIN=agenora.cc.cd

# ===== BYOK gate =====
# true  (recommended for any public deploy): users MUST configure their own
#       LLM + embedding keys in /settings — owner keys never shared.
# false (dev/demo): chat falls back to the keys below when user hasn't set theirs.
BYOK_REQUIRED=true

# ===== Admin dashboard (06-01) =====
# Comma-separated emails promoted to platform admin (is_admin) on every startup.
# The account must register through the app first; on the next restart it gains
# access to /admin (stats + user management + KB management). Leave empty to
# disable seeding (admins can still be granted at runtime by an existing admin).
#   ADMIN_EMAILS=you@example.com,ops@example.com
ADMIN_EMAILS=

# ===== LLM provider + fallback keys (only used when BYOK_REQUIRED=false) =====
LLM_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_COMPLEX_MODEL=deepseek-v4-pro
# KB query policy: always_direct | rule_only | llm_fallback | always_llm
KB_QUERY_POLICY_MODE=llm_fallback
KB_QUERY_POLICY_MAX_QUERIES=3
KB_QUERY_POLICY_LLM_MODEL=deepseek-v4-flash
# Automatic route for unbound chats: off | rule_only | llm_fallback | always_llm.
# Only readable KBs are candidates; a low-confidence route stays in general chat.
KB_AUTO_ROUTE_MODE=llm_fallback
KB_AUTO_ROUTE_MAX_CANDIDATES=8
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small

# ===== Rate limit (per user, per hour) =====
RATE_LIMIT_PER_HOUR=60

# ===== LightRAG Server + Neo4j (optional knowledge-graph recall) =====
# These services start only with ``docker compose --profile kg ...``.
# Backend talks to LightRAG over HTTP (Server mode, not embedded Core).
# Local uvicorn (without Compose): point at http://localhost:9621 after
# starting neo4j + lightrag, or leave LIGHTRAG_BASE_URL empty to disable.
LIGHTRAG_ENABLED=false
LIGHTRAG_BASE_URL=
# Set in the Required section above.
# local is faster than hybrid for query; use hybrid only if multi-hop quality needs it.
LIGHTRAG_QUERY_MODE=local
LIGHTRAG_TIMEOUT_S=20
LIGHTRAG_KG_TOP_K=12
# When vector KB already has a strong hit, only wait this long for KG.
LIGHTRAG_KG_SOFT_WAIT_S=0
LIGHTRAG_KG_ONLY_WHEN_NEEDED=true
NEO4J_USER=neo4j
# Set in the Required section above.
NEO4J_DATABASE=neo4j
# LightRAG Server needs its own LLM/embedding keys for entity extraction:
LIGHTRAG_LLM_BINDING_API_KEY=
LIGHTRAG_EMBEDDING_BINDING_API_KEY=
# LIGHTRAG_LLM_BINDING_HOST=https://api.deepseek.com/v1
# LIGHTRAG_LLM_MODEL=deepseek-v4-flash
# LIGHTRAG_EMBEDDING_BINDING_HOST=https://api.openai.com/v1
# LIGHTRAG_EMBEDDING_MODEL=text-embedding-3-small
# LIGHTRAG_EMBEDDING_DIM=1536

# ===== Observability (internal Trace + Langfuse) =====
# Root `.env` is read by Compose and passed into the backend service.
TRACE_ENABLED=true
# May contain prompts, retrieved private documents and model output. Keep off unless needed.
TRACE_STORE_IO=false
# External export is opt-in; use a self-hosted endpoint when data residency requires it.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# SaaS regions: https://cloud.langfuse.com (EU) | https://us.cloud.langfuse.com
# | https://jp.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
# Optional; empty uses APP_ENV (compose APP_ENV=prod → production)
# LANGFUSE_TRACING_ENVIRONMENT=production

# ===== RAG quality monitor =====
# The rag-monitor Compose service logs alerts after this many retrieval calls.
RAG_MONITOR_WINDOW_HOURS=24
RAG_MONITOR_INTERVAL_SECONDS=300
RAG_MONITOR_MIN_CALLS=20
RAG_MONITOR_MAX_ERROR_RATE=0.05
RAG_MONITOR_MAX_EMPTY_RATE=0.45
RAG_MONITOR_MAX_P95_LATENCY_MS=5000
RAG_MONITOR_MIN_AVG_TOP_SCORE=0.50
