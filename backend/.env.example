# ===== LLM =====
ANTHROPIC_API_KEY=sk-ant-api03-xxx
ANTHROPIC_BASE_URL=https://api.anthropic.com
LLM_DEFAULT_MODEL=claude-haiku-4-5-20251001
LLM_COMPLEX_MODEL=claude-sonnet-4-6

# ===== KB query policy =====
# always_direct | rule_only | llm_fallback | always_llm
KB_QUERY_POLICY_MODE=llm_fallback
KB_QUERY_POLICY_MAX_QUERIES=3
KB_QUERY_POLICY_LLM_MODEL=
# Automatic routing for blank/general conversations: off | rule_only |
# llm_fallback | always_llm. It considers only KBs readable by the user.
KB_AUTO_ROUTE_MODE=llm_fallback
KB_AUTO_ROUTE_MAX_CANDIDATES=8
# Per-route candidates / final evidence injected / minimum dense cosine score.
KB_RETRIEVAL_CANDIDATE_LIMIT=6
KB_RETRIEVAL_FINAL_LIMIT=3
KB_RETRIEVAL_MIN_DENSE_SCORE=0.4
# Skip optional KG recall when the vector KB has a dense hit at or above this score.
KB_KG_SKIP_IF_DENSE_SCORE_GE=0.7

# ===== Web search budgets =====
GENERAL_WEB_SEARCH_MAX_CALLS=2
GENERAL_WEB_SEARCH_RESULTS_PER_CALL=5
GENERAL_WEB_SEARCH_EVIDENCE_LIMIT=5
KB_WEB_SEARCH_MAX_CALLS=1
KB_WEB_SEARCH_RESULTS_PER_CALL=3
KB_WEB_SEARCH_EVIDENCE_LIMIT=3

# ===== Multi-agent runtime =====
# Empty RAG may append one chat follow-up. Planned qa_kb → qa_chat does not need this.
AGENT_ALLOW_RAG_CHAT_HANDOFF=true
# rule_only | rule_triage | layered (rule → triage small model → complex)
AGENT_ROUTE_MODE=layered

# ===== Web search =====
# WEB_SEARCH_PROVIDER=duckduckgo | brave | bing | tavily
# BRAVE_SEARCH_API_KEY=
# BING_SEARCH_API_KEY=
# TAVILY_API_KEY=

# ===== Vector DB =====
# VECTOR_STORE: milvus (default, pure-Python embedded, Windows OK) | qdrant | local
VECTOR_STORE=milvus

# Milvus — pick one URI form:
#   Milvus Lite (embedded, pure Python, Windows OK):  ./data/milvus_local.db
#   Standalone / Zilliz Cloud:  http://host:19530    (set MILVUS_TOKEN too)
MILVUS_URI=./data/milvus_local.db
MILVUS_TOKEN=

# Qdrant (set VECTOR_STORE=qdrant to use; requires qdrant.exe or docker)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=default

# ===== Source document storage =====
# local preserves the existing backend/data/uploads layout.
# s3 also works with MinIO; it requires the optional `boto3` package.
OBJECT_STORAGE=local
# OBJECT_STORAGE_LOCAL_ROOT=/absolute/path/to/uploads
# OBJECT_STORAGE=s3
# OBJECT_STORAGE_BUCKET=agenora-documents
# OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_REGION=us-east-1

# ===== Embedding =====
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=bge-m3

# ===== Server =====
APP_ENV=dev
SCHEMA_BOOTSTRAP=true
LOG_LEVEL=INFO
RATE_LIMIT_PER_HOUR=20
CORS_ORIGINS=http://localhost:3000

# ===== BYOK gate (v2-M2) =====
# false (default): chat / KB ops fall back to the LLM / embedding keys above
#                  when a user hasn't configured their own in /settings.
# true:           every user MUST configure their own LLM + embedding before
#                  chat / create_kb / upload work — set this for public deploys
#                  so the project owner's keys aren't shared with all users.
BYOK_REQUIRED=false

# ===== Observability (internal Trace DB + Langfuse) =====
# Internal span trees → app DB (default on). Admin: GET /api/admin/traces
TRACE_ENABLED=true
# I/O previews may contain private prompts/documents. Enable only for local debugging.
TRACE_STORE_IO=false
# External Langfuse is opt-in. Configure a self-hosted endpoint if data residency requires it.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=1.0
# Optional; empty uses APP_ENV (prod→production, dev→development)
# LANGFUSE_TRACING_ENVIRONMENT=production

# ===== RAG quality monitor =====
RAG_MONITOR_WINDOW_HOURS=24
RAG_MONITOR_INTERVAL_SECONDS=300
RAG_MONITOR_MIN_CALLS=20
RAG_MONITOR_MAX_ERROR_RATE=0.05
RAG_MONITOR_MAX_EMPTY_RATE=0.45
RAG_MONITOR_MAX_P95_LATENCY_MS=5000
RAG_MONITOR_MIN_AVG_TOP_SCORE=0.50
