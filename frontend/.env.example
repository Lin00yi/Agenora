NEXT_PUBLIC_APP_NAME=Agenora
BACKEND_URL=http://localhost:8000

# Knowledge-base control in the chat composer:
# hidden (default): no KB selector; enter from a KB page via “基于此知识库提问”.
# selectable: show the pre-send “通用对话 / 知识库” selector.
NEXT_PUBLIC_CHAT_KB_SELECTION_MODE=selectable

# v2-M7 — Plausible analytics (optional, leave blank to skip)
# Set to your site domain registered in Plausible, e.g. "agenora.example.com".
# Must use NEXT_PUBLIC_ prefix so it's exposed to the browser.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
